start:  header title nps _NL*

header : CODE "version" STAMP "mpi"? "ld=" STAMP "probid =" STAMP STAMP _NL

CODE: /\w+/

_NL: /\n/

// MCNP version idenficiation entry on title line
STAMP: /[.0-9\/:]+/

title: EVERYTHING _NL

EVERYTHING.-10: /[^\n]+/

?nps: _NPS_LABEL int ".00"? _NL

_NPS_LABEL: "Number of histories used for normalizing tallies ="

int: INT


// Numbers
%import common.INT
// Separators / whitespace (ignored)
%import common.WS_INLINE
%ignore WS_INLINE
