import numpy as np

from numpy.typing import ArrayLike

from .types import NPFloatArray, NPInt8Array, NPInt32Array

class Surface:
    def test_points(self, points: ArrayLike) -> NPInt8Array: ...
    def test_box(self, box: Box) -> int: ...

class Box:
    def __init__(
        self,
        center: ArrayLike,
        xdim: float,
        ydim: float,
        zdim: float,
        /,
        ex: ArrayLike = ...,
        ey: ArrayLike = ...,
        ez: ArrayLike = ...,
    ) -> None: ...
    @property
    def center(self) -> NPFloatArray: ...
    @property
    def dimensions(self) -> NPFloatArray: ...
    @property
    def ex(self) -> NPFloatArray: ...
    @property
    def ey(self) -> NPFloatArray: ...
    @property
    def ez(self) -> NPFloatArray: ...
    @property
    def bounds(self) -> NPFloatArray: ...
    @property
    def corners(self) -> NPFloatArray: ...
    @property
    def volume(self) -> float: ...
    def copy(self) -> Box: ...
    def generate_random_points(self, npts: int) -> NPFloatArray: ...
    def check_intersection(self, box: Box) -> bool: ...
    def split(self, *, dir: str = ..., ratio: float = ...) -> tuple[Box, Box]: ...  # noqa: A002
    def test_points(self, points: ArrayLike) -> NPInt32Array: ...

class Shape:
    # Operation codes, see enum Operation in _geometry/shape.h:
    # "I" - intersection of Shapes, "C" - complement of a Surface,
    # "E" - empty shape, "U" - union of Shapes, "S" - identity of a Surface,
    # "R" - universe shape.
    opc: str
    invert_opc: str
    args: tuple[Shape | Surface, ...]
    def __init__(self, _opc: str, *_args: Shape | Surface) -> None: ...
    def test_points(self, points: ArrayLike) -> NPInt8Array: ...
    def test_box(self, box: Box) -> int: ...
    def ultimate_test_box(
        self, box: Box = ..., min_volume: float = ..., collect: bool = ...
    ) -> int: ...
    def volume(self, box: Box = ..., min_volume: float = ...) -> float: ...
    def bounding_box(self, tol: float = ..., box: Box = ...) -> Box: ...
    def collect_statistics(self, box: Box, min_vol: float) -> None: ...
    def get_stat_table(self) -> np.ndarray[tuple[int, int], np.dtype[np.uint8]]: ...

class Plane(Surface):
    def __init__(self, norm: ArrayLike, offset: float, /) -> None: ...
    @property
    def _v(self) -> NPFloatArray: ...
    @property
    def _k(self) -> float: ...

class Sphere(Surface):
    def __init__(self, center: ArrayLike, radius: float, /) -> None: ...
    @property
    def _center(self) -> NPFloatArray: ...
    @property
    def _radius(self) -> float: ...

class Cylinder(Surface):
    def __init__(self, point: ArrayLike, axis: ArrayLike, radius: float, /) -> None: ...
    @property
    def _pt(self) -> NPFloatArray: ...
    @property
    def _axis(self) -> NPFloatArray: ...
    @property
    def _radius(self) -> float: ...

class Cone(Surface):
    def __init__(self, apex: ArrayLike, axis: ArrayLike, ta: float, sheet: int, /) -> None: ...
    @property
    def _apex(self) -> NPFloatArray: ...
    @property
    def _axis(self) -> NPFloatArray: ...
    @property
    def _t2(self) -> float: ...
    @property
    def _sheet(self) -> int: ...

class GQuadratic(Surface):
    def __init__(self, m: ArrayLike, v: ArrayLike, k: float, factor: float, /) -> None: ...
    @property
    def _m(self) -> NPFloatArray: ...
    @property
    def _v(self) -> NPFloatArray: ...
    @property
    def _k(self) -> float: ...
    @property
    def _factor(self) -> float: ...

class Torus(Surface):
    def __init__(
        self, center: ArrayLike, axis: ArrayLike, r: float, a: float, b: float, /
    ) -> None: ...
    @property
    def _center(self) -> NPFloatArray: ...
    @property
    def _axis(self) -> NPFloatArray: ...
    @property
    def _R(self) -> float: ...
    @property
    def _a(self) -> float: ...
    @property
    def _b(self) -> float: ...

class RCC(Surface):
    def __init__(self, cylinder: Cylinder, top: Plane, bot: Plane, /) -> None: ...
    @property
    def surfaces(self) -> tuple[Cylinder, Plane, Plane]: ...

class BOX(Surface):
    def __init__(
        self,
        plane1: Plane,
        plane2: Plane,
        plane3: Plane,
        plane4: Plane,
        plane5: Plane,
        plane6: Plane,
        /,
    ) -> None: ...
    @property
    def surfaces(self) -> tuple[Plane, Plane, Plane, Plane, Plane, Plane]: ...

EX: NPFloatArray
EY: NPFloatArray
EZ: NPFloatArray
ORIGIN: NPFloatArray
GLOBAL_BOX: Box
MIN_VOLUME: float
