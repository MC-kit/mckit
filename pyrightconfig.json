{
  "venvPath": ".",
  "venv": ".venv",
  "typeCheckingMode": "basic",
  "include": [
    "src"
  ],
  "exclude": [
    "**/data",
    "**/__pycache__",
    "**/.*",
    "wrk"
  ],
  "extraPaths": ["src/mckit"],
  "reportGeneralTypeIssues": "none",
  "reportMissingImports": "error",
  "reportMissingTypeStubs": false,
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux",
  "stubPath": "src/mckit",
  "useLibraryCodeForTypes": true
}
