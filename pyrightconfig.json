{
  "venvPath": ".pixi/envs",
  "venv": "default",
  "typeCheckingMode": "basic",
  "include": [
    "src"
  ],
  "exclude": [
    "**/data",
    "**/parser",
    "**/__pycache__",
    "**/.*"
  ],
  "reportMissingImports": "error",
  "reportMissingTypeStubs": false,
  "pythonVersion": "3.13",
  "pythonPlatform": "Linux"
}
