# Ignore "hidded" files and directoies
.*

### Marimo state files
__marimo__/

### Python template
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.so.*

# Distribution / packaging
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
coverage.xml
*.cover


# PLY generated tables
*_tab.py

# Translations
*.mo
*.pot

# Sphinx documentation
docs/_build/

# PyBuilder
target/


# mkdocs documentation
/site

**/parser.out
**/parsetab.py


dist/
wrk/

# benchmark resuls
*uncommited-changes.json

#cmake work folders
cmake-build-debug


# Visual studio
.vs
